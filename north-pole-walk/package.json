{
  "name": "north-pole-walk",
  "private": true,
  "description": "A team walking journey from Layton, Utah to the North Pole. Cloudflare Pages + D1.",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "db:local": "wrangler d1 execute north-pole-walk --local --file=schema.sql",
    "db:remote": "wrangler d1 execute north-pole-walk --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
